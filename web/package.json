{
  "name": "hearth-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PUBLIC_HEARTH_API_BASE=same vite dev",
    "e2e": "playwright test",
    "predev": "npm run factory-status && npm run builds-status && npm run threads-status && npm run needs-you-status && npm run features-status",
    "build": "vite build",
    "prebuild": "npm run factory-status && npm run builds-status && npm run threads-status && npm run needs-you-status && npm run features-status",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run src",
    "factory-status": "node scripts/factory-status.mjs",
    "builds-status": "node scripts/builds-status.mjs",
    "threads-status": "node scripts/threads-status.mjs",
    "needs-you-status": "node scripts/needs-you-status.mjs",
    "features-status": "node scripts/features-status.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vite-pwa/sveltekit": "^1.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4"
  }
}
